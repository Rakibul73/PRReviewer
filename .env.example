# GitHub App credentials
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_NAME=prreviewer-bot

# ─── AI Provider Toggle ────────────────────────────────────────────────────────
# Choose which AI backend to use: anthropic | groq | gemini
# Only the key for the selected provider needs to be set.
AI_PROVIDER=anthropic

# Anthropic (Claude)
# Models used: claude-sonnet-4-20250514
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Groq (LLaMA 3.3 70B — fastest, free tier available)
# Models used: llama-3.3-70b-versatile
# Get key: https://console.groq.com/
GROQ_API_KEY=gsk_...

# Google Gemini (Gemini 2.0 Flash)
# Models used: gemini-2.0-flash
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
